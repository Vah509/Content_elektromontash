<style>
/* ============================================================
   СТИЛІ СТОРІНКИ — Про нас
   elektromontazh.kiev.ua / pro-nas.css
   Підключається разом з design-system-v1.1.css
   ============================================================ */

/* ХЛІБНІ КРИХТИ */
.breadcrumbs-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 12px 24px 0;
}
.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 6px;
  font-family: var(--ff-body);
  font-size: 13px;
  color: var(--c-muted);
}
.breadcrumbs a {
  color: var(--c-muted);
  text-decoration: none;
  transition: color var(--transition);
}
.breadcrumbs a:hover {
  color: var(--c-accent);
}
.breadcrumbs-sep {
  color: var(--c-muted);
  opacity: 0.5;
}
.breadcrumbs [aria-current="page"] {
  color: var(--c-accent);
  font-weight: 500;
}

/* ТАБЛИЦЯ ФАКТІВ + ФОТО */
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  align-items: start;
  margin-top: 32px;
}
.about-table {
  width: 100%;
  border-collapse: collapse;
}
.about-table tr {
  border-bottom: 1px solid var(--c-divider);
}
.about-table tr:last-child {
  border-bottom: none;
}
.about-table-label {
  padding: 13px 16px 13px 0;
  color: var(--c-muted);
  font-size: 14px;
  width: 45%;
  vertical-align: top;
  font-family: var(--ff-body);
}
.about-table-value {
  padding: 13px 0;
  font-weight: 600;
  color: var(--c-head);
  font-size: 15px;
  font-family: var(--ff-body);
  line-height: 1.5;
}
.about-phone {
  color: var(--c-accent);
  text-decoration: none;
  font-weight: 700;
  transition: color var(--transition);
}
.about-phone:hover {
  color: var(--c-accent-hover);
}

/* ЗАГЛУШКА ФОТО */
.about-photo-placeholder {
  background: var(--c-bg2);
  border: 2px dashed var(--c-accent-border);
  border-radius: var(--radius);
  aspect-ratio: 4/3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: var(--c-muted);
  font-size: 14px;
  text-align: center;
  padding: 24px;
  font-family: var(--ff-body);
}
.about-photo-placeholder svg {
  width: 48px;
  height: 48px;
  fill: var(--c-accent);
  opacity: 0.2;
}
.about-photo-hint {
  font-size: 12px;
  color: var(--c-accent);
  font-style: italic;
}

/* РЕАЛЬНЕ ФОТО — стиль коли буде додано */
.about-photo-real {
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}
.about-photo-real img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* ТЕКСТ СПЕЦІАЛІЗАЦІЇ */
.about-text {
  font-size: 16px;
  color: var(--c-text);
  line-height: 1.75;
  max-width: 800px;
  margin-bottom: 16px;
  font-family: var(--ff-body);
}
.about-text:last-child {
  margin-bottom: 0;
}

/* 4 КАРТКИ ПРИНЦИПІВ */
.principles-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
  margin-top: 32px;
}
.principle-card {
  background: var(--c-bg2);
  border: 1.5px solid var(--c-accent-border);
  border-radius: var(--radius);
  padding: 28px;
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
}
.principle-card:hover {
  border-color: var(--c-accent);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}
.principle-icon {
  font-size: 28px;
  margin-bottom: 14px;
  line-height: 1;
}
.principle-card h3 {
  font-size: 16px;
  font-weight: 700;
  color: var(--c-head);
  margin-bottom: 8px;
  font-family: var(--ff);
}
.principle-card p {
  font-size: 14px;
  color: var(--c-muted);
  line-height: 1.65;
  font-family: var(--ff-body);
}

/* АДАПТИВ */
@media (max-width: 900px) {
  .about-grid {
    grid-template-columns: 1fr;
    gap: 32px;
  }
  .about-photo-placeholder {
    display: none; /* приховуємо заглушку на мобільному */
  }
  .about-photo-real {
    display: block; /* реальне фото — показуємо */
  }
}

@media (max-width: 640px) {
  .principles-grid {
    grid-template-columns: 1fr;
  }
  .principle-card {
    padding: 20px;
  }
}
</style>
